# Documentation only: export build variables in your shell or set them in Workers Builds.
# Wrangler runtime overrides belong in .dev.vars locally or Worker variables in production.

# Public routing keys, with these defaults already in code. Errors and logs (service.name freetypist-website) go here.
SENTRY_DSN=https://cdd8a725c00b40dd8ded87246c3c35b1@error.cnnct.uk/45
PUBLIC_SENTRY_DSN=https://cdd8a725c00b40dd8ded87246c3c35b1@error.cnnct.uk/45

# Optional build-only secret for source maps. Never put this in Worker runtime variables.
SENTRY_AUTH_TOKEN=

# Reporting is on only for `wrangler deploy` (production) and `wrangler versions upload` (preview).
# Local dev, plain builds and scripts never report, even with a DSN set. Tests never report.
# Set SENTRY_FORCE=1 to report from a local run on purpose: export it for the build (Worker and browser),
# or put it in .dev.vars (Worker only). Leave it unset afterwards and never set it in Workers Builds.
SENTRY_FORCE=

# Optional build/runtime overrides. The environment defaults to production, preview or development as above.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
